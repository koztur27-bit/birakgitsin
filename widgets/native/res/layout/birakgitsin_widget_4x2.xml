<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root_4x2"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_background_4x2"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_brand_4x2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BIRAK GİTSİN"
            android:textColor="#93C5FD"
            android:textSize="10sp"
            android:textStyle="bold"
            android:singleLine="true" />

        <View
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_open_4x2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aç →"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/widget_button_4x2"
            android:paddingLeft="10dp"
            android:paddingRight="10dp"
            android:paddingTop="4dp"
            android:paddingBottom="4dp"
            android:singleLine="true" />
    </LinearLayout>

    <TextView
        android:id="@+id/widget_quit_counter_4x2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:gravity="center_vertical"
        android:text="0 gün 00 saat"
        android:textColor="#FFFFFF"
        android:textSize="23sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_savings_4x2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tasarruf: 0 ₺"
        android:textColor="#86EFAC"
        android:textSize="13sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_next_4x2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="2dp"
        android:text="Sıradaki pencere --:--"
        android:textColor="#94A3B8"
        android:textSize="10sp"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
