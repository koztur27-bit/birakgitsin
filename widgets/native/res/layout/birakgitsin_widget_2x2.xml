<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:background="@drawable/widget_card_bg"
    android:padding="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/widget_brand"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="BIRAK GİTSİN"
            android:textColor="#93C5FD"
            android:textSize="10sp"
            android:textStyle="bold"
            android:letterSpacing="0.08"
            android:singleLine="true" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="1dp"
            android:layout_weight="1" />

        <TextView
            android:id="@+id/widget_open"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Aç →"
            android:textColor="#FFFFFF"
            android:textSize="10sp"
            android:textStyle="bold"
            android:background="@drawable/widget_action_bg"
            android:paddingLeft="9dp"
            android:paddingRight="9dp"
            android:paddingTop="3dp"
            android:paddingBottom="3dp"
            android:singleLine="true" />
    </LinearLayout>

    <TextView
        android:layout_width="match_parent"
        android:layout_height="2dp"
        android:layout_marginTop="6dp"
        android:background="@drawable/widget_accent_line" />

    <TextView
        android:id="@+id/widget_counter"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:layout_marginTop="3dp"
        android:gravity="center_vertical"
        android:text="0 gün 00 sa"
        android:textColor="#FFFFFF"
        android:textSize="18sp"
        android:textStyle="bold"
        android:autoSizeTextType="uniform"
        android:autoSizeMinTextSize="14sp"
        android:autoSizeMaxTextSize="24sp"
        android:autoSizeStepGranularity="1sp"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_savings"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Tasarruf: 0 ₺"
        android:textColor="#86EFAC"
        android:textSize="12sp"
        android:textStyle="bold"
        android:singleLine="true"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/widget_next"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="1dp"
        android:text="Sıradaki pencere --:--"
        android:textColor="#CBD5E1"
        android:textSize="9sp"
        android:singleLine="true"
        android:ellipsize="end" />
</LinearLayout>
