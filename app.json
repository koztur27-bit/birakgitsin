{
  "expo": {
    "name": "Let It Go",
    "slug": "birakgitsin",
    "version": "2.5.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.birakgitsin.app",
      "infoPlist": {
        "CFBundleDisplayName": "Let It Go"
      }
    },
    "android": {
      "package": "com.birakgitsin.app",
      "versionCode": 82,
      "adaptiveIcon": {
        "backgroundColor": "#0D1B2A",
        "foregroundImage": "./assets/android-icon-foreground.png",
        "backgroundImage": "./assets/android-icon-background.png",
        "monochromeImage": "./assets/android-icon-monochrome.png"
      },
      "predictiveBackGestureEnabled": false,
      "permissions": [
        "android.permission.POST_NOTIFICATIONS"
      ],
      "blockedPermissions": [
        "android.permission.RECORD_AUDIO",
        "android.permission.SYSTEM_ALERT_WINDOW",
        "android.permission.READ_EXTERNAL_STORAGE",
        "android.permission.WRITE_EXTERNAL_STORAGE",
        "android.permission.ACCESS_FINE_LOCATION",
        "android.permission.ACCESS_COARSE_LOCATION",
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "Let It Go",
      "shortName": "Let It Go",
      "description": "Sigarayı azaltarak bırakma sayacı",
      "themeColor": "#2563EB",
      "backgroundColor": "#F2F6FD",
      "orientation": "portrait",
      "display": "standalone",
      "startUrl": "/"
    },
    "plugins": [
      "expo-task-manager",
      "@react-native-community/datetimepicker",
      [
        "expo-audio",
        {
          "recordAudioAndroid": false
        }
      ],
      "./plugins/withSilentSound",
      "./plugins/withCiFastBuild",
      "./plugins/withHermesCommand",
      "expo-asset",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "resizeMode": "contain",
          "backgroundColor": "#F2F6FD",
          "imageWidth": 200
        }
      ],
      "./plugins/withWidgetExported",
      "./plugins/withNativeWidget",
      "./plugins/withShortcut",
      "./plugins/withPinWidget",
      "./plugins/withWidgetData",
      [
        "react-native-google-mobile-ads",
        {
          "androidAppId": "ca-app-pub-3940256099942544~3347511713",
          "iosAppId": "ca-app-pub-3940256099942544~1458002511"
        }
      ],
      [
        "expo-notifications",
        {
          "icon": "./assets/notification-icon.png",
          "color": "#1E62D0"
        }
      ],
      "./plugins/withNotificationIcon.js",
      "./plugins/withProguardRules.js",
      "./plugins/withReleaseSigning.js",
      "./plugins/withAppNameLocalization.js"
    ],
    "extra": {
      "eas": {
        "projectId": "599c1947-ec45-4c30-b398-9a7d77f59919"
      }
    },
    "owner": "koztur",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/599c1947-ec45-4c30-b398-9a7d77f59919"
    },
    "locales": {
      "tr": "./locales/tr.json",
      "en": "./locales/en.json"
    }
  }
}
